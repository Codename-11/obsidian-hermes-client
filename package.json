{
  "name": "obsidian-hermes-client",
  "version": "0.1.4",
  "description": "Generic Hermes Agent API Server chat sidebar client for Obsidian, forked from ObsidianClaw.",
  "main": "main.js",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "versions.json",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "assets/",
    "landing/"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "dev:watch": "node esbuild.config.mjs --watch",
    "dev:local": "node esbuild.config.mjs --watch --deploy",
    "deploy:local": "node esbuild.config.mjs --deploy",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint main.ts"
  },
  "keywords": [
    "obsidian",
    "hermes-agent",
    "ai",
    "agent",
    "chat",
    "streaming",
    "vision",
    "brat"
  ],
  "author": "Codename_11",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.56.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
